[
{{- $pages := where .Site.Pages "Kind" "in" (slice "page" "section") -}}
{{- $pages = where $pages "Params.bookSearchExclude" "!=" true -}}
{{- $pages = where $pages "RawContent" "!=" "" -}}

{{- $seen := newScratch -}}
{{- $seen.Set "map" dict -}}
{{- $first := true -}}
{{- range $pages -}}
{{- $href := .RelPermalink -}}
{{- if not (index ($seen.Get "map") $href) -}}
{{- if not $first}},{{end}}{
  "href": {{ $href | jsonify }},
  "title": {{ (partial "docs/title" .) | jsonify }}
}
{{- $first = false -}}
{{- end -}}
{{- $seen.SetInMap "map" $href true -}}
{{- end -}}
]