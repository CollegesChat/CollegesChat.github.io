[
{{- $pages := where .Site.Pages "Kind" "in" (slice "page" "section") -}}
{{- $pages = where $pages "Params.bookSearchExclude" "!=" true -}}
{{- $pages = where $pages "Content" "!=" "" -}}

{{- $seen := dict -}}
{{- $first := true -}}
{{- range $pages -}}
{{- $href := .RelPermalink -}}
{{- if not (index $seen $href) -}}
{{- if not $first}},{{end}}{
  "href": {{ $href | jsonify }},
  "title": {{ (partial "docs/title" .) | jsonify }}
}
{{- $seen = merge $seen (dict $href true) -}}
{{- $first = false -}}
{{- end -}}
{{- end -}}
]